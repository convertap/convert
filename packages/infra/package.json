{
  "name": "@convert/infra",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly",
    "test": "vitest run --project unit",
    "generate": "drizzle-kit generate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "migrate": "tsx scripts/migrate.ts",
    "pre-deploy": "pnpm run bootstrap && pnpm run migrate",
    "assert:rls": "tsx scripts/assert-rls.ts",
    "assert:conventions": "tsx scripts/assert-conventions.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@convert/contracts": "workspace:*",
    "@convert/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "@types/pg": "^8.11.10"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
