# Copy to .env.local and fill in. Never commit a filled copy.

# --- database ---
# The application role must NOT be able to bypass row-level security (ADR 0002).
DATABASE_URL=postgres://convert:convert@localhost:5432/convert

# --- api ---
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Shared secret the web BFF presents when calling the API server-side (ADR 0013).
API_SERVICE_TOKEN=dev-only-change-me

# --- web ---
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Signs the httpOnly session cookie held by the web app. Browser never sees a token.
SESSION_SECRET=dev-only-change-me

# --- messaging (checklist E0/E3 - unset until a provider is chosen) ---
# Leaving these empty selects the logging adapter, which records sends and delivers
# nothing. That is deliberate: no real message can leave a developer machine by accident.
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
