# Secrets live in Infisical, not in a file on your machine (ADR 0020).
#
# This file is the contract: it names every variable the apps expect and explains what
# each one is for. It never holds a value. Run the app with the secrets injected:
#
#   infisical run --env=dev -- pnpm dev
#
# First time on a machine:
#
#   infisical login         # .infisical.json is committed, so the project link is already here
#
# If you genuinely need a local file (offline work, a debugger that cannot inherit the
# environment), export one and delete it when you are done. .gitignore already blocks it:
#
#   infisical export --env=dev > .env.local

# --- database ---
# The application role must NOT be able to bypass row-level security (ADR 0002).
#
# This is not automatic, and the default on a managed host is usually wrong. Railway's
# Postgres hands out a connection string for the `postgres` superuser, and a superuser
# ignores row-level security entirely. So does the table owner, unless the table is marked
# FORCE ROW LEVEL SECURITY. Either way every tenant policy silently does nothing while
# gate G7 reports green, because G7 asserts that RLS is *enabled*, not that the connecting
# role is subject to it.
#
# Before the first tenant table exists, DATABASE_URL must name a role that is neither
# superuser nor the owner of the tables it reads. Staging currently uses the superuser
# string, which is safe only because no tenant table exists yet (I1, ADR 0002).
DATABASE_URL=

# --- api ---
# Local only. A host that assigns ports injects PORT, which takes precedence over both of
# these; binding anything else means the platform routes to a closed socket while the
# process looks healthy (ADR 0022).
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
# Shared secret the web BFF presents when calling the API server-side (ADR 0013).
API_SERVICE_TOKEN=

# --- web ---
# Local only, same as API_PORT: Next reads PORT when the host sets one.
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Signs the httpOnly session cookie held by the web app. The browser never sees a token.
SESSION_SECRET=

# --- tooling ---
# Notion integration token, prefixed ntn_. Read by tools/push_notion_mirror.py only, to
# publish git-owned diagrams into the stakeholder workspace (ADR 0021). Nothing in the
# running application uses it, and it is never needed in CI: gate G15 compares the manifest
# against the working tree and does no network access at all.
#
# The integration sees nothing until each mirrored page is shared with it. An unshared page
# and a bad token look identical from the outside, so share first, then debug.
NOTION_TOKEN=

# --- messaging (checklist E0/E3, unset until a provider is chosen) ---
# Leaving WHATSAPP_PROVIDER as "log" selects the logging adapter, which records sends and
# delivers nothing. That is deliberate: no real message can leave a developer machine by
# accident, and no WhatsApp credential is needed to work on the rest of the product.
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=

# Ports and URLs above are not secrets. They are listed here so one file describes the
# whole environment, but they are safe to keep in Infisical alongside the real secrets.
