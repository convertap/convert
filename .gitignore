# Secrets — never commit provider credentials (Meta, BSP, SMS aggregator)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dependencies
node_modules/
.pnpm-store/
vendor/
__pycache__/
*.py[cod]
.venv/
venv/

# Build output
dist/
build/
.next/

# Turbo's local build cache. Machine-specific and useless to anyone else: 60 files and
# 2.4 MB of it had been committed, including .tar.zst archives of build output.
.turbo/

# Railway's infrastructure-as-code scaffold. Its CLI cannot read it on Windows: it
# appends ?namespace=... to a raw Windows path instead of a file:// URL, so `railway
# config plan` and `pull` both fail to import. Service settings live in the Railway
# dashboard until that is fixed upstream. See ADR 0022.
out/
*.tsbuildinfo

# Test & coverage
coverage/
.nyc_output/
.pytest_cache/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Office lock files (Word leaves these next to an open .docx)
~$*

# Logs & local databases
*.log
npm-debug.log*
*.sqlite
*.sqlite3

# Delegate scratch artifacts (deck renders — regenerable from the .pptx)
.codex-review/

# Delegate and verification reports. Evidence that matters goes into an ADR, not here.
.reports/
