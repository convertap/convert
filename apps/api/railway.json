{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm turbo run build --filter=@convert/api",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/pnpm-lock.yaml",
      "/turbo.json",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm --filter @convert/infra bootstrap",
      "pnpm --filter @convert/infra migrate"
    ],
    "startCommand": "pnpm --filter @convert/api start",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
